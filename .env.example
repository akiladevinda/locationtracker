# Copy this file to `.env` and fill in values.
# Never commit real secrets. The mobile app may only use EXPO_PUBLIC_* values.

# --- Mobile (safe to ship as public client config, not privileged) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional override. Defaults to ${EXPO_PUBLIC_SUPABASE_URL}/functions/v1
EXPO_PUBLIC_BACKEND_URL=

# Google OAuth for Drive uploads (user-authorized).
# Create an Android OAuth client AND a Web OAuth client in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-oauth-client-id.apps.googleusercontent.com
# Folder ID only (from the Drive URL), not the full https link:
# https://drive.google.com/drive/folders/FOLDER_ID_HERE
EXPO_PUBLIC_GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# --- Backend only (Supabase Edge Function secrets — NEVER put these in the APK) ---
# Set with: supabase secrets set NAME=value
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}
GOOGLE_SHEET_ID=10VCfYb0pfZnw8mJkm5zgX76CHussUA8i52BhDTATvWQ
GOOGLE_SHEET_RANGE=Sheet1!A1
